{
  "name": "next-with-text",
  "description": "llms.txt, llms-full.txt, and per-page markdown for Next.js — one line in next.config.ts",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyrusNuevoDia/next-with-text.git"
  },
  "homepage": "https://github.com/CyrusNuevoDia/next-with-text#readme",
  "bugs": {
    "url": "https://github.com/CyrusNuevoDia/next-with-text/issues"
  },
  "keywords": [
    "next",
    "nextjs",
    "llms.txt",
    "llmstxt",
    "markdown",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./route": {
      "types": "./src/route.ts",
      "default": "./dist/route.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=cjs --outfile=dist/index.cjs --packages=external && bun build src/patch.ts --target=node --format=cjs --outfile=dist/patch.cjs --external=@xberg-io/html-to-markdown && bun build src/route.ts --target=node --format=esm --outfile=dist/route.js --external=@xberg-io/html-to-markdown",
    "test": "bun run build && bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "dependencies": {
    "@xberg-io/html-to-markdown": "^3.10.6",
    "multimatch": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "@types/node": "^24",
    "next": "latest"
  }
}
